{
  "opencollection": "1.0.0",
  "info": {
    "name": "Agile CRM REST Campaigns Companies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Companies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve company list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.agilecrm.com/dev/api/contacts/companies/list"
          },
          "docs": "Retrieve company list"
        }
      ]
    }
  ],
  "bundled": true
}